---
/**
 * @file Layout.astro
 * @description Shell maestro de la aplicación con fuentes oficiales de Google Fonts (Stitch Framework),
 * prevención de FOUC, metadatos y arquitectura de islas.
 */

import '../styles/global.css';
import Navbar from '../components/Navbar.svelte';
import FooterLegal from '../components/FooterLegal.svelte';

interface Props {
  title?: string;
  description?: string;
  hideNavFooter?: boolean;
}

const { 
  title = "SIMA - Plataforma de Calidad Ambiental · Colombia", 
  description = "Conoce y analiza en tiempo real la calidad del agua según las normativas oficiales (Res. 2115 de 2007) de forma rápida, clara y accesible para todos.",
  hideNavFooter = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts oficiales de Stitch Design System -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300..800;1,300..800&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Poppins:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Geist:wght@300;400;500;600;700&display=swap" 
      rel="stylesheet" 
    />
    <link 
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" 
      rel="stylesheet" 
    />

    <!-- Metadatos Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="SIMA Colombia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.png" />

    <!-- Schema.org estructurado JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SIMA Colombia",
      "alternateName": "Sistema Integral de Monitoreo Ambiental",
      "description": description,
      "applicationCategory": "EducationalApplication, EnvironmentalApplication",
      "operatingSystem": "All",
      "inLanguage": "es-CO",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "COP"
      }
    })} />

    <!-- Script en línea para prevenir flash de tema incorrecto (FOUC) -->
    <script is:inline>
      (function() {
        try {
          const guardado = localStorage.getItem('theme');
          const prefiereOscuro = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const tema = guardado ? guardado : (prefiereOscuro ? 'dark' : 'dark');
          
          if (tema === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-surface text-on-surface min-h-screen flex flex-col font-['Poppins',sans-serif] selection:bg-primary-container selection:text-white transition-colors duration-200">
    <!-- Skip-Link accesible (WCAG 2.2 AAA) -->
    <a 
      href="#contenido-principal" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary focus:font-semibold text-sm transition-all"
    >
      Saltar al contenido principal
    </a>

    {!hideNavFooter && <Navbar client:load />}

    <!-- Main Content Slot -->
    <main id="contenido-principal" class="flex-1 w-full" tabindex="-1">
      <slot />
    </main>

    {!hideNavFooter && <FooterLegal client:idle />}
  </body>
</html>
