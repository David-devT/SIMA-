---
/**
 * @file Layout.astro
 * @description Master layout component implementing Astro's Islands Architecture shell.
 * 
 * Performance & Architecture Considerations:
 * - Soporte nativo para Modo Oscuro y Modo Claro con prevención de parpadeo (FOUC).
 * - Integración del componente Navbar interactivo con selector de accesibilidad WCAG 2.2 AAA.
 * - Iconografía vectorial y emblema institucional oficial (/logo.png).
 */

import '../styles/global.css';
import Navbar from '../components/Navbar.svelte';
import FooterLegal from '../components/FooterLegal.svelte';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SIMA Colombia | Sistema Integral de Monitoreo Ambiental", 
  description = "Simulador de evaluación de calidad ambiental en Colombia bajo resoluciones del MinAmbiente y MinSalud." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Metadatos Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="SIMA Colombia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.png" />

    <!-- Schema.org estructurado JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SIMA Colombia",
      "alternateName": "Sistema Integral de Monitoreo Ambiental",
      "description": description,
      "applicationCategory": "EducationalApplication, EnvironmentalApplication",
      "operatingSystem": "All",
      "inLanguage": "es-CO",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "COP"
      }
    })} />

    <!-- Script en línea para prevenir flash de tema incorrecto (FOUC) -->
    <script is:inline>
      (function() {
        try {
          const guardado = localStorage.getItem('theme');
          const prefiereOscuro = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const tema = guardado ? guardado : (prefiereOscuro ? 'dark' : 'light');
          
          if (tema === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[#F8FAFC] dark:bg-[#0f1419] text-[#0F172A] dark:text-[#dee3ea] min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] selection:bg-emerald-500 selection:text-white transition-colors duration-200">
    <!-- Skip-Link accesible (WCAG 2.2 AAA) -->
    <a 
      href="#contenido-principal" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-emerald-600 focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:font-semibold text-sm transition-all"
    >
      Saltar al contenido principal
    </a>

    <!-- Navbar Institucional con Controles de Accesibilidad -->
    <Navbar client:load />

    <!-- Main Content Slot -->
    <main id="contenido-principal" class="flex-1 w-full" tabindex="-1">
      <slot />
    </main>

    <!-- Footer Institucional con Respaldo Normativo y Modal Legal -->
    <FooterLegal client:idle />
  </body>
</html>
